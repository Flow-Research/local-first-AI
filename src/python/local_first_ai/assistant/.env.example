# All settings are optional. Without these values the CLI prompts for an
# inference engine and model at startup.
# LOCAL_FIRST_AI_ENGINE=llama
# OPENAI_MODEL=/path/to/model.gguf
# LOCAL_FIRST_AI_MODEL_URL=https://host/model.gguf
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=not-needed
# ASSISTANT_STREAM=false
# LOCAL_CONTEXT_DB_PATH=data/context.db
# LOCAL_FIRST_AI_RUNTIME_DIR=/path/to/cache
